      "id": "4b3bd11f-44f2-40f3-bb6f-1ad69bb04773",
      "cell_type": "code",
      "source": "#Se ajustan las dimenciones de la figura a 2x2\nfig, axs = plt.subplots(2, 2, figsize=(10, 10), sharex=True, sharey=True, constrained_layout=True)\n#Aqui se generan los 4 sigmas entre 0.25 y 1\nsigmas = np.linspace(0.25, 1.0, 4)\n#Un \"for\" para rellenar cada gráfico usando zip() y axs.ravel() -->transforma la matriz de 2x2 en una lista de una sola dimensión\nfor ax, sigma in zip(axs.ravel(), sigmas):\n    \"\"\"\n    Se supone que este for recorre un \"cuadro\" o \"ax\" junto con su sigma correpondiente\n    y les hace el mismo proceso de hacer un broadcast y crear la imagen con la escala de color\n    \"\"\"\n    Z = I0 * np.exp(-((X[:, :, None] - x0)**2 + (Y[:, :, None] - y0)**2) / (2 * sigma**2))\n    #Se fusionan (igual que antes) las 5 estrellas en una imagen 2D\n    imagen_sigma = np.sum(Z, axis=2)\n    # Graficar en el 'ax' correspondiente usando la escala de color\n    im = ax.imshow(imagen_sigma, origin=\"lower\", extent=[x.min(), x.max(), y.min(), y.max()], cmap=\"inferno\", vmin=0, vmax=I0)\n    #Se ajusta el formato de los ticks, xlabel, título, y tambien decidir cuantos decimales tiene sigma\n    ax.set_xticks(np.arange(-6, 7, 2))\n    ax.set_yticks(np.arange(-6, 7, 2))\n    ax.set_xlabel(\"X\", fontsize=14)\n    ax.tick_params(labelsize=14)\n    ax.set_title(f\"$\\\\sigma$ = {sigma:.3e}\", fontsize=14)\n#Se añade la etiqueta \"Y\" solo a los dos gráficos que están en la columna izquierda (sino quedarian en medio, un poco raro)\naxs[0, 0].set_ylabel(\"Y\", fontsize=14)\naxs[1, 0].set_ylabel(\"Y\", fontsize=14)\n#Barra de color para la figura\ncbar = fig.colorbar(im,ax=axs,location=\"right\",shrink=1.,pad=0.02)\ncbar.set_label(\"Intensity\", fontsize=15)\ncbar.ax.tick_params(labelsize=15)\n#Se muestra la imagen :D\nplt.show()\n#mientras más aumenta sigma, más difusas están las estrellas, de hecho, podemos observar como en sigma=1\n# ya no se pueden diferenciar más de tres estrellas",
