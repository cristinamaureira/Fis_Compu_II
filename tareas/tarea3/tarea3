      "cell_type": "code",
      "source": "#Suma todas las filas (axis=0) y todas las columnas (axis=1) de una\nintensidades_totales = np.sum(Z, axis=(0, 1))\n#Y se ordena segun la intensidad\nindices_ordenados = np.argsort(intensidades_totales)\n#Se construye la figura junto con su ax\nfig, ax = plt.subplots(1, 1, figsize=(12, 8), constrained_layout=True)\n#Se aplana para ser de dos dimensiones\nimagen_total = np.sum(Z, axis=2)\nim = ax.imshow(imagen_total, origin=\"lower\", extent=[x.min(), x.max(), y.min(), y.max()], cmap=\"inferno\")\nfor numero_etiqueta, idx in enumerate(indices_ordenados, start=1):\n    ax.text(x0[idx], y0[idx], str(numero_etiqueta), color=\"black\", fontsize=15, fontweight=\"bold\", ha=\"center\", va=\"center\")\n#se ajustan los ticks para ir de dos en dos y llegar hasta 6\nax.set_xticks(np.arange(-6, 7, 2))\nax.set_yticks(np.arange(-6, 7, 2))\n#los \"label\" o etiquetas de los ejes, el titulo, la barra de color y el tamaño de la letra \nax.set_xlabel(\"X\", fontsize=14)\nax.set_ylabel(\"Y\", fontsize=14)\nax.tick_params(labelsize=14)\nax.set_title(\"Estrellas Enumeradas (Menor a Mayor Intensidad)\", fontsize=14)\ncbar = fig.colorbar(im, ax=ax)\ncbar.set_label(\"Intensidad Acumulada\", fontsize=14)\ncbar.ax.tick_params(labelsize=14)\nplt.show()",
