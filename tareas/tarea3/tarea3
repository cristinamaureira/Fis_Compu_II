      "id": "b1dc253c-1cec-4761-adf7-852f46b9bff1",
      "cell_type": "code",
      "source": "def figura(tiempo, flujo):\n    \"\"\"\n    Crea un gráfico a partir de un arreglo de tiempo y otro de flujo de mismas dimensiones\n\n    Parameters\n    ----------\n    transito: numpy.ndarray\n        arreglo de números que son el tiempo en el que sucede el flujo\n    flujo: numpy.ndarray\n        flujo que sucede en el transito\n\n    Returns\n    -------\n    plt.show()\n        Muestra la figura creada\n    \"\"\"\n    umbral = np.mean(flujo) - (3*np.std(flujo)) #defini el lumbral a parte para poder usarlo en plt.axhline\n    condicion = flujo < umbral\n    \"\"\"\n    para que x e y tengan las mismas dimensiones tuve que poner la máscara también al tiempo\n    se supone que si se atraviesa el umbral aparecen estrellas magentas\n    \"\"\"\n    plt.plot(tiempo[condicion], flujo[condicion], zorder=1, marker=\"*\", c=\"m\")#zorder=1 hace que la otra recta no tape los puntos destacados\n    plt.plot(tiempo, flujo, label=\"flujo\", zorder=0, marker=\".\")\n    plt.axhline(np.mean(flujo), ls=\"--\", c=\"r\", label=\"Fmean\")\n    plt.axhline(umbral, ls=\"--\", c=\"m\", label=\"Fmean − 3σ\")\n    plt.axvline(tiempo[0], ls=\":\", c=\"b\", label=\"inicio\")#linea vertical que marca el inicio\n    plt.axvline(tiempo[-1], ls=\":\", c=\"c\", label=\"fin\")#la que maraca el final\n    plt.xlabel(\"tiempo [años]\", fontsize=14)\n    plt.ylabel(\"flujo observado\", fontsize=14)\n    plt.title(\"Transito planetario en frente de estrella x\")\n    plt.legend(fontsize=14)\n    return plt.show()",
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "execution_count": 22
    },
