      "source": "\"\"\"\nEjercicio 2\n-Se uso mucho el broadcasting\n\"\"\"\n#valores fijos\nsigma0 = 0.5 #sigma base\nN_estrellas = 5\nI0 = 100\n#Grilla espacial (400pixeles wau)\nx = np.linspace(-6, 6, 400) #de -6 a 6 para cubrir todas las posiciones\ny = np.linspace(-6, 6, 400)\nX, Y = np.meshgrid(x, y)\n#Posiciones aleatorias de las 5 estrellas\nx0 = rng.uniform(-5, 5, N_estrellas)\ny0 = rng.uniform(-5, 5, N_estrellas)\n#se usa el broadcasting para hacerlo más rápido\nZ = I0*np.exp(-((X[:, :, None] - x0)**2 + (Y[:, :, None] - y0)**2) / (2 * sigma0**2))\nZ_broadcast = np.sum(Z, axis=2)\nplt.figure(figsize=(12, 8)) #más tamaño, más se pueden ver las diferencias entre las figuras (antes lo intente con 7 y 6, no lo recomiendo)\nplt.imshow(Z_broadcast, extent=[-6, 6, -6, 6], origin='lower', cmap='inferno')\n#los labels, titulo y ticks\nplt.title(\"Imagen de 5 estrellas\", fontsize=14)\nplt.xlabel(\"Coordenada X\", fontsize=14)\nplt.ylabel(\"Coordenada Y\", fontsize=14)\nplt.tick_params(labelsize=14)\n#la barra de color\ncbar = plt.colorbar()\ncbar.set_label(\"Intensidad\", fontsize=14)\ncbar.ax.tick_params(labelsize=14)\nplt.show()",
